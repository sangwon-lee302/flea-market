msg_file="$1"

# Strip comment lines (starting with #) before checking, so template comments don't trigger this.
content=$(grep -v '^#' "$msg_file")

if printf '%s' "$content" | LC_ALL=C grep -qP '[^\x00-\x7F]'; then
  echo "Error: commit message must be written in English (non-ASCII characters detected)." >&2
  echo "--- offending message ---" >&2
  printf '%s\n' "$content" >&2
  exit 1
fi
