parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany\:\:search\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Http/Controllers/ItemController.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$item_id\.$#'
			identifier: property.notFound
			count: 1
			path: app/Models/Order.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:categories\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Services/ItemService.php

		-
			message: '#^Method App\\Services\\ItemService\:\:storeItem\(\) should return App\\Models\\Item but returns Illuminate\\Database\\Eloquent\\Model\.$#'
			identifier: return.type
			count: 1
			path: app/Services/ItemService.php

		-
			message: '#^Call to an undefined method Faker\\Generator\:\:secondaryAddress\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: database/factories/OrderFactory.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Schema\\ForeignKeyDefinition\:\:unique\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: database/migrations/2026_04_01_113429_create_profiles_table.php

		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 1
			path: tests/DuskTestCase.php

		-
			message: '#^Parameter \#1 \$value of method Illuminate\\Testing\\TestResponse\<Symfony\\Component\\HttpFoundation\\Response\>\:\:assertSee\(\) expects list\<string\>\|string, int given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Feature/Items/ShowTest.php

		-
			message: '#^Parameter \#1 \$value of method Illuminate\\Testing\\TestResponse\<Symfony\\Component\\HttpFoundation\\Response\>\:\:assertSee\(\) expects list\<string\>\|string, int\|null given\.$#'
			identifier: argument.type
			count: 2
			path: tests/Feature/Items/ShowTest.php

		-
			message: '#^Access to an undefined property App\\Models\\Profile\:\:\$name\.$#'
			identifier: property.notFound
			count: 2
			path: tests/Feature/Profiles/ShowTest.php
